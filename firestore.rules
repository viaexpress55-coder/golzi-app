rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios — lectura pública del ranking, escritura solo el propio usuario
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Partidos — solo lectura pública
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // Predicciones — lectura y escritura solo autenticados
    match /predictions/{predId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Ligas — lectura pública, escritura autenticados
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Torneos — solo lectura pública
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }

    // Negocios — solo lectura pública
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}